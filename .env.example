# Copy to .env and fill in private values locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-v4-pro
GITEE_TOKEN=
# Windows local execution backend: use an independent workspace directory.
AI_WORKSPACE_ROOT=E:\ai_workspace
# Optional; otherwise select a repository for each new task.
DUBONLINE_AICODING_DEFAULT_REPO=
DUBONLINE_AICODING_LOG_LEVEL=INFO
DUBONLINE_AICODING_LOG_RETENTION_DAYS=14
VITE_DASHBOARD_API_BASE_URL=http://127.0.0.1:2024
